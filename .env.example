# Copy to .env and fill in. Read by scripts/run_local.sh; .env is gitignored.
# Leave a value empty and the monitor logs the alert instead of sending it.

# Bot token from @BotFather, e.g. 123456789:AA...
TELEGRAM_BOT_TOKEN=

# Chat to message: result[0].message.chat.id from the bot's getUpdates
TELEGRAM_CHAT_ID=

# Timezone the run is dated in; defaults to Africa/Cairo when unset
CHECK_TZ=Africa/Cairo
